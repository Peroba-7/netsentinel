# Copie para .env e preencha. O .env nunca deve entrar no git.

# Chave de serviço (opcional): acesso total à API, para scripts e integrações.
# Vazia, fica desativada. As pessoas entram com utilizador e palavra-passe.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Login: validade da sessão e bloqueio após tentativas falhadas
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# PostgreSQL (usado pelo Docker Compose; use só letras e números na palavra-passe)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=netsentinel

# Valores para correr fora do Docker; o Compose substitui os endereços pelos internos.
DATABASE_URL=postgresql://postgres:ALTERAR@localhost:5432/netsentinel
REDIS_URL=redis://localhost:6379/0
API_URL=http://127.0.0.1:8000

# IA
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=300

# Pedidos de análise por cliente, por minuto (0 desativa)
RATE_LIMIT_PER_MINUTE=10

# Segundos entre verificações de bloqueios com prazo vencido (0 desativa)
BLOCK_EXPIRY_INTERVAL_SECONDS=60

# Origem dos IPs (país e ASN) com as bases locais DB-IP Lite, descarregadas com
# scripts/update-geoip.ps1 para data/geoip/. Por omissão usa esses ficheiros;
# defina as duas variáveis vazias para desligar.
# GEOIP_COUNTRY_DB=data/geoip/dbip-country-lite.mmdb
# GEOIP_ASN_DB=data/geoip/dbip-asn-lite.mmdb

# Notificações (opcionais)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/netsentinel
# Segredo do webhook do n8n. Gere com o mesmo comando da API_KEY (outro valor).
N8N_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
