# Copie para .env e preencha. O .env nunca deve entrar no git.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# PostgreSQL (usado pelo Docker Compose; use só letras e números na palavra-passe)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=netsentinel

# Valores para correr fora do Docker; o Compose substitui os endereços pelos internos.
DATABASE_URL=postgresql://postgres:ALTERAR@localhost:5432/netsentinel
REDIS_URL=redis://localhost:6379/0
API_URL=http://127.0.0.1:8000

# IA
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120

# Pedidos de análise por cliente, por minuto (0 desativa)
RATE_LIMIT_PER_MINUTE=10

# Notificações (opcionais)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/netsentinel
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
